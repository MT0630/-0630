<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="ユーザー補助の設定を開く" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="設定で「AutoTapper」をオンにしてください。\nAndroid 13以降で「制限付き設定」と出てオンにできない場合は、アプリ情報 → 右上の︙ → 「制限付き設定を許可」を押してから再度オンにします。"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="タップ間隔（ミリ秒）" />

        <EditText
            android:id="@+id/editInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <CheckBox
            android:id="@+id/chkShizuku"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Shizukuで連打する（実験的）" />

        <TextView
            android:id="@+id/shizukuStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="オンにすると、連打中も指で視点移動などができる可能性があります。端末やAndroidのバージョンによっては、指で触ると連打か指の操作のどちらかが止まります。うまくいかなければオフに戻してください。"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnAdd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="連打ボタンを追加" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="すべて削除" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="使い方\n・連打ボタンをドラッグして、連打したい位置に置く\n・音量ボタン（下）を押している間だけ連打（ボタンが緑になります）\n・音量ボタンを離すと停止、また押すと再開\n・連打ボタンを長押し：削除\n\nボタンの中心が連打される位置です。複数置くと 1→2→3… の順に回ります。連打ボタンが1つも無いときは、音量ボタンは普通に音量操作として使えます。"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
